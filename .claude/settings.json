{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(make *)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go mod *)",
      "Bash(go run ./tools/*)",
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npx playwright *)",
      "Bash(terraform fmt *)",
      "Bash(terraform validate *)",
      "Bash(terraform init *)",
      "Bash(terraform plan *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git mv *)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin propose/*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin propose/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Edit(/.claude/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/Makefile)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(git reset --hard*)"
    ]
  },
  "effortLevel": "high",
  "showClearContextOnPlanAccept": true,
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "excludedCommands": ["gh *", "terraform init *", "terraform validate*", "make check-infra"],
    "filesystem": {
      "allowWrite": ["~/Library/Caches/go-build", "~/.cache/go-build", "~/go/pkg/mod"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-tests.sh" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/archive-session.sh" }]
      }
    ]
  }
}
